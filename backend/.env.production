APP_NAME="FastAPI JWT Auth"
APP_VERSION="1.0.0"
APP_DESCRIPTION="FastAPI backend with JWT authentication"
DEBUG=false
ENVIRONMENT=production

HOST=0.0.0.0
PORT=8000

# MUST be overridden via real secrets manager in production
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Update with your production frontend domain
ALLOWED_ORIGINS=["https://yourdomain.com"]

# PostgreSQL example
DATABASE_URL=postgresql://user:password@db:5432/appdb

RATE_LIMIT_PER_MINUTE=60

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
