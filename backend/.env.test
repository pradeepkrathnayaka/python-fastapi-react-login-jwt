APP_NAME="FastAPI JWT Auth"
APP_VERSION="1.0.0"
APP_DESCRIPTION="FastAPI backend with JWT authentication"
DEBUG=false
ENVIRONMENT=test

HOST=0.0.0.0
PORT=8000

SECRET_KEY=test-secret-key-for-testing-purposes-only-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=sqlite:///./test.db

RATE_LIMIT_PER_MINUTE=1000

LOG_LEVEL=WARNING
LOG_FILE=logs/test.log
